{
  "name": "clothingmart",
  "version": "0.1.0",
  "private": true,
  "description": "A professional full-stack e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace apps/web",
    "build:frontend": "npm run build --workspace apps/web",
    "start:frontend": "npm run start --workspace apps/web",
  
    "dev:backend": "npm run dev --workspace apps/api",
    "build:backend": "npm run build --workspace apps/api",
    "start:backend": "npm run start --workspace apps/api",
  
    "build": "npm run build:frontend && npm run build:backend"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^1.42.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
