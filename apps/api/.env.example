
# ==========================================
# ClothingMart - Backend Configuration
# ==========================================

# Application
NODE_ENV="development"
API_HOST="localhost"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/clothingmart_dev"

# Authentication
ACCESS_TOKEN_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
REFRESH_TOKEN_SECRET="REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET"

# Initial admin seed
ADMIN_SEED_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"

# PayPal Sandbox
PAYPAL_CLIENT_ID="YOUR_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_SANDBOX_CLIENT_SECRET"
PAYPAL_WEBHOOK_ID="YOUR_SANDBOX_WEBHOOK_ID"

# PayPal environment: sandbox or live
PAYPAL_ENVIRONMENT="sandbox"

# Explicit production activation safeguard
PAYPAL_LIVE_ENABLED="false"

# Exchange Rate Provider
EXCHANGE_RATE_API_KEY="YOUR_EXCHANGE_RATE_API_KEY"
EXCHANGE_RATE_API_BASE_URL="https://v6.exchangerate-api.com/v6"









# Development-only destructive demo seeding.
# Never enable for production databases.
ALLOW_DESTRUCTIVE_SEED="false"