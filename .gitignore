
# ==========================================
# ClothingMart - Root .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
.vercel/
next-env.d.ts

# Build and testing output
dist/
build/
coverage/
*.tsbuildinfo

# Environment variables (all workspaces)
.env
.env.*
**/.env
**/.env.*

# Allow safe environment templates
!.env.example
!**/.env.example

# Backend uploads
apps/api/uploads/

# Generated Prisma Client
apps/api/src/generated/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Certificates and private keys
*.pem
*.key

# Operating system files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
